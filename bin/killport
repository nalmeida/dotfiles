#!/usr/bin/env bash

VERSION="1.0.0"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print functions that respect color codes
print_error() {
    echo -e "${RED}${1}${NC}" >&2
}

print_success() {
    echo -e "${GREEN}${1}${NC}"
}

print_warning() {
    echo -e "${YELLOW}${1}${NC}"
}

print_info() {
    echo -e " ${NC}${1}${NC}"
}

show_help() {
    echo -e "killport $VERSION • @nalmeida"
    echo ""
    echo "Usage: killport [PORT]"
    echo ""
    echo "Kills all processes running on the specified TCP port."
    echo ""
    echo "Options:"
    echo "  -h, --help           Display this help message"
    echo "  -v, --version        Display the version"
    echo ""
    echo "Examples:"
    echo "  killport 3000"
    echo "  killport 8080"
    exit 0
}

show_version() {
    echo "killport $VERSION"
    exit 0
}

# Argument parsing
if [[ $# -lt 1 ]]; then
    print_error "Error: Missing port argument."
    show_help
    exit 1
fi

case "$1" in
    -h|--help)
        show_help
        ;;
    -v|--version)
        show_version
        ;;
    *)
        PORT=$1
        ;;
esac

if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
    print_error "Error: Port argument must be a number."
    show_help
    exit 1
fi

# Check if lsof is installed
if ! command -v lsof >/dev/null 2>&1; then
    print_error "Error: lsof is not installed."
    print_info "Install lsof using: brew install lsof"
    exit 1
fi

PIDS=$(lsof -t -i:"$PORT")
if [[ -z "$PIDS" ]]; then
    print_warning "No process found running on port $PORT."
    exit 0
fi

kill -9 $PIDS
if [[ $? -eq 0 ]]; then
    print_success "Successfully killed process(es) on port $PORT."
else
    print_error "Failed to kill process(es) on port $PORT."
fi
