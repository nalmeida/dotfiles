#!/usr/bin/env bash

VERSION="2.0.0"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Print functions that respect color codes
print_error() {
    echo -e "${RED}${1}${NC}" >&2
}

print_warning() {
    echo -e "${YELLOW}${1}${NC}"
}

print_info() {
    echo -e " ${NC}${1}${NC}"
}

# Print a label+value row with fixed column alignment
print_row() {
    local label="$1"
    local value="$2"
    printf "${CYAN}%-20s${NC} ${GREEN}%s${NC}\n" "$label" "$value"
}

show_help() {
    echo -e "ip $VERSION • @nalmeida"
    echo ""
    echo "Usage: ip [OPTIONS]"
    echo ""
    echo "Shows all IP addresses: local network interfaces and internet IP(s)."
    echo "Proxy detection is automatic — only shown when a proxy is in use."
    echo ""
    echo "Options:"
    echo "  -h, --help           Display this help message"
    echo "  -v, --version        Display the version"
    echo ""
    echo "Examples:"
    echo "  ip                   Print all IPs"
    exit 0
}

show_version() {
    echo "ip $VERSION"
    exit 0
}

# Resolve the org name for an IP via ipinfo.io, stripping the AS number prefix
get_org_name() {
    local ip="$1"
    curl -s --max-time 3 "https://ipinfo.io/${ip}/org" 2>/dev/null | sed 's/^AS[0-9]* //'
}

show_all() {
    # Check if curl is available
    if ! command -v curl >/dev/null 2>&1; then
        print_error "Error: curl is not installed."
        print_info "Install curl using: brew install curl"
        exit 1
    fi

    # --- Local network interfaces ---
    for iface in en0 en1 en2 en3 en4 utun0; do
        local ip
        ip=$(ipconfig getifaddr "$iface" 2>/dev/null)
        if [ -n "$ip" ]; then
            local label
            case "$iface" in
                en0)   label="Wi-Fi (en0)" ;;
                en1)   label="Ethernet (en1)" ;;
                en2)   label="Ethernet (en2)" ;;
                en3)   label="Ethernet (en3)" ;;
                en4)   label="Ethernet (en4)" ;;
                utun0) label="VPN (utun0)" ;;
            esac
            print_row "$label" "$ip"
        fi
    done

    # --- Internet IPs ---
    # Fetch from two services: one that tends to bypass proxies, one that doesn't
    local ip_real ip_proxy
    ip_real=$(curl -s --max-time 5 https://api.ipify.org 2>/dev/null)
    ip_proxy=$(curl -s --max-time 5 https://ifconfig.me 2>/dev/null)

    if [ -z "$ip_real" ] && [ -z "$ip_proxy" ]; then
        print_error "Error: Could not retrieve internet IP. Check your connection."
        exit 1
    fi

    if [ "$ip_real" = "$ip_proxy" ]; then
        # No proxy detected — single internet IP
        [ -n "$ip_real" ] && print_row "Internet IP" "$ip_real"
    else
        # Proxy detected — show real IP and proxied IP with org name
        [ -n "$ip_real" ] && print_row "Internet IP" "$ip_real"
        if [ -n "$ip_proxy" ]; then
            local proxy_org
            proxy_org=$(get_org_name "$ip_proxy")
            if [ -n "$proxy_org" ]; then
                print_row "Proxied IP" "$ip_proxy (${proxy_org})"
            else
                print_row "Proxied IP" "$ip_proxy"
            fi
        fi
    fi
}

# Argument parsing
case "$1" in
    -h|--help)
        show_help
        ;;
    -v|--version)
        show_version
        ;;
    "")
        show_all
        ;;
    *)
        print_error "Error: Unknown option '$1'."
        echo "Use 'ip --help' for usage information."
        exit 1
        ;;
esac
